# Backend API Keys Configuration
# Copy this file to .env and fill in your actual API keys
# NEVER commit the .env file to version control

# Pricelab API Configuration
PRICELAB_API_KEY=your_pricelab_api_key_here
PRICELAB_API_URL=https://api.pricelab.com
PRICELAB_ENVIRONMENT=production

# Maptier API Configuration
MAPTIER_API_KEY=your_maptier_api_key_here
MAPTIER_API_URL=https://api.maptier.com
MAPTIER_ENVIRONMENT=production
